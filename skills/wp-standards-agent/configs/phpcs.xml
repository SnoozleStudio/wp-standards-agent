<?xml version="1.0"?>
<ruleset name="{{SLUG}}">
	<description>Enterprise WordPress standards: WordPress-Extra + Docs + PHPCompatibility</description>

	<file>.</file>
	<exclude-pattern>node_modules/*</exclude-pattern>
	<exclude-pattern>vendor/*</exclude-pattern>
	<exclude-pattern>dist/*</exclude-pattern>
	<exclude-pattern>*.bak</exclude-pattern>

	<arg name="extensions" value="php"/>
	<arg value="ps"/>

	<config name="testVersion" value="8.2-"/>
	<config name="minimum_supported_wp_version" value="6.8"/>

	<rule ref="WordPress-Extra"/>
	<rule ref="WordPress-Docs"/>
	<rule ref="PHPCompatibility"/>

	<rule ref="WordPress.WP.I18n">
		<properties>
			<property name="text_domain" value="{{TEXT_DOMAIN}}"/>
		</properties>
	</rule>
</ruleset>